# RRNET - FreeRADIUS config (REST-only relay, NO password validation)
# FreeRADIUS = relay only, Backend = single source of truth

server default {
	listen {
		type = auth
		ipaddr = *
		port = 0
	}

	listen {
		type = acct
		ipaddr = *
		port = 0
	}

	authorize {
		preprocess
		
		# Panggil Backend ERP di sesi Authorize biar PAP, CHAP, dan v7 semua masuk kuali
		update control {
			&REST-HTTP-Header += "X-RRNET-RADIUS-SECRET: $ENV{RRNET_RADIUS_REST_SECRET}"
		}

		rest
		
		# Jika Backend bilang ACCEPT (200 OK) atau ngasih Atribut (Updated)
		if (ok || updated) {
			# Paksa sukses biar gak butuh Auth-Type lain
			update control {
				Auth-Type := Accept
			}
		}
		# Jika Backend bilang REJECT (403/401)
		elsif (userlock || reject) {
			update control {
				Auth-Type := Reject
			}
		}
	}

	authenticate {
		# Kosongin aja karena pemeriksaan udah beres di Authorize
		Auth-Type Accept {
			ok
		}
		Auth-Type Reject {
			reject
		}
	}

	preacct {
		preprocess
	}

	accounting {
		update control {
			&REST-HTTP-Header += "X-RRNET-RADIUS-SECRET: $ENV{RRNET_RADIUS_REST_SECRET}"
		}
		rest
	}
}
